.form-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.name-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.name-input:focus {
  border-color: #07c160;
  background: #ffffff;
}

.add-btn {
  padding: 0 28rpx;
}

.participant-list {
  max-height: 320rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
}

.participant-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.participant-item:last-child {
  border-bottom: none;
}

.participant-label {
  font-size: 28rpx;
  color: #333333;
}

.remove-btn {
  margin-left: 16rpx;
}

.clear-btn {
  margin-top: 24rpx;
}

.draw-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
}
