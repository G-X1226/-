page {
  background: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
}

.container {
  padding: 24rpx 32rpx 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 39, 75, 0.08);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.primary-btn {
  background: #07c160;
  color: #ffffff;
  border: none;
}

.primary-btn[disabled] {
  background: #c8e6d6;
}

.secondary-btn {
  color: #07c160;
  border: 2rpx solid #07c160;
  background: #ffffff;
}

.result {
  font-size: 48rpx;
  font-weight: 700;
  color: #07c160;
  text-align: center;
  margin-top: 24rpx;
}

.empty-placeholder {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 40rpx 0;
}
